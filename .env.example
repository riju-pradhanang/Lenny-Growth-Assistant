# Required for Docker Compose
POSTGRES_DB=lenny_growth
POSTGRES_USER=lenny
POSTGRES_PASSWORD=change-me-before-sharing
DATABASE_URL=postgresql+psycopg://lenny:change-me-before-sharing@postgres:5432/lenny_growth

# Model selection (used in Phase 2; safe to configure now)
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://host.docker.internal:11434
FALLBACK_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Local-only transcript embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
CHUNK_SIZE=900
CHUNK_OVERLAP=150
